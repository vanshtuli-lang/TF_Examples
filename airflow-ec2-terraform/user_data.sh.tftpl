#!/bin/bash
# Airflow bootstrap. Rendered by Terraform and run once by cloud-init at first boot:
#   1. install the container runtime (podman or docker), nfs-utils and the AWS CLI
#   2. mount EFS at /opt/airflow (if enabled)
#   3. write /etc/airflow/airflow.env: settings below + secrets read from SSM
#   4. pull the Airflow image
#   5. check the database, then start Airflow as systemd services: db migrate,
#      then api-server, scheduler, dag-processor, triggerer (with health checks)
#   6. confirm the API answers and every service stays up
# This file holds no secrets. Log: /var/log/airflow-bootstrap.log
# Safe to re-run on the instance: sudo bash /var/lib/cloud/instance/scripts/part-001
set -euo pipefail
exec > >(tee -a /var/log/airflow-bootstrap.log) 2>&1
export PATH="$PATH:/usr/local/bin"

RUNTIME='${runtime}'
IMAGE='${image}'
REGION='${region}'
BASE=/opt/airflow
ETC=/etc/airflow
COMPONENTS="api-server scheduler dag-processor triggerer"

log() { echo "[airflow-bootstrap $(date -u +%H:%M:%S)] $*"; }
die() { log "ERROR: $*"; exit 1; }

# shellcheck disable=SC1091
. /etc/os-release

# ------------------------------------------------------------------ 1. packages

log "installing packages on $PRETTY_NAME"
dnf install -y nfs-utils unzip
if [ "$RUNTIME" = podman ]; then
  [ "$ID" != amzn ] || die "Amazon Linux has no podman package. Use a RHEL 9 AMI or container_runtime = \"docker\"."
  dnf install -y podman
elif [ "$ID" = amzn ]; then
  dnf install -y docker
else
  dnf install -y dnf-plugins-core
  dnf config-manager --add-repo https://download.docker.com/linux/rhel/docker-ce.repo
  dnf install -y docker-ce docker-ce-cli containerd.io
fi
if [ "$RUNTIME" = docker ]; then systemctl enable --now docker; fi
RT=$(command -v "$RUNTIME")
"$RT" --version
if [ "$RUNTIME" = podman ]; then
  # 4.6 added --health-on-failure, which restarts a hung component.
  PODMAN_VERSION=$(podman version --format '{{.Client.Version}}')
  if [ "$(printf '%s\n' 4.6.0 "$PODMAN_VERSION" | sort -V | head -n1)" != 4.6.0 ]; then
    die "podman $PODMAN_VERSION is too old: 4.6 or newer is required"
  fi
fi

# Amazon Linux ships the AWS CLI; RHEL does not.
if ! command -v aws > /dev/null 2>&1; then
  log "installing AWS CLI v2"
  curl -fsSL -o /tmp/awscliv2.zip https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip
  unzip -q -o /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install --update
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi

# ------------------------------------------------------------------ 2. storage

mkdir -p "$BASE"
%{ if efs_dns != "" ~}
# EFS over plain NFS (RHEL has no amazon-efs-utils), with AWS's recommended options.
OPTS="nfsvers=4.1,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2,noresvport,_netdev"
# With SELinux on, label the whole mount so containers can use it.
if command -v selinuxenabled > /dev/null 2>&1 && selinuxenabled; then OPTS="$OPTS,context=system_u:object_r:container_file_t:s0"; fi
grep -q " $BASE " /etc/fstab || echo "${efs_dns}:/ $BASE nfs4 $OPTS 0 0" >> /etc/fstab
# EFS DNS can take a minute to resolve after the file system is created.
for _ in $(seq 1 30); do
  mountpoint -q "$BASE" && break
  mount "$BASE" || sleep 10
done
mountpoint -q "$BASE" || die "could not mount EFS at $BASE"
SELINUX_LABEL=''
%{ else ~}
# Local disk: let the runtime apply the SELinux label (:z).
SELINUX_LABEL=z
%{ endif ~}
mkdir -p "$BASE/dags" "$BASE/logs" "$BASE/config"
chmod 0755 "$BASE" "$BASE/dags"

# ------------------------------------------------------------------ 3. settings and secrets

mkdir -p "$ETC"
chmod 0700 "$ETC"
umask 077

log "writing $ETC/airflow.env"
cat > "$ETC/airflow.env" << 'EOF'
%{ for k, v in airflow_env ~}
${k}=${v}
%{ endfor ~}
EOF

# Every SecureString under ${ssm_env_path}/ becomes an environment variable
# (parameter name = variable name).
aws ssm get-parameters-by-path --region "$REGION" --path '${ssm_env_path}' --recursive --with-decryption \
  --query 'Parameters[].[Name,Value]' --output text |
  while IFS=$'\t' read -r name value; do
    echo "$${name##*/}=$value"
  done >> "$ETC/airflow.env"
grep -q '^AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=' "$ETC/airflow.env" || die "no database secret found under ${ssm_env_path}"
chmod 0600 "$ETC/airflow.env"

# UI users' passwords: one SecureString per user under ${ssm_users_path}/.
PASSWORDS='{'
SEP=''
while IFS=$'\t' read -r name value; do
  PASSWORDS="$PASSWORDS$SEP\"$${name##*/}\": \"$value\""
  SEP=', '
done < <(aws ssm get-parameters-by-path --region "$REGION" --path '${ssm_users_path}' --with-decryption \
  --query 'Parameters[].[Name,Value]' --output text)
PASSWORDS="$PASSWORDS}"
[ -n "$SEP" ] || die "no user passwords found under ${ssm_users_path}"

# ------------------------------------------------------------------ 4. image

if [[ "$IMAGE" == *.dkr.ecr.*.amazonaws.com/* ]]; then
  log "logging in to ECR"
  aws ecr get-login-password --region "$REGION" | "$RT" login --username AWS --password-stdin "$${IMAGE%%/*}"
fi
for i in 1 2 3 4 5; do
  log "pulling $IMAGE (attempt $i)"
  "$RT" pull "$IMAGE" && break
  [ "$i" -lt 5 ] || die "could not pull $IMAGE"
  sleep 15
done

# The container user must own logs/ and config/. (Chainguard images have no `id`.)
AF_UID=$("$RT" run --rm --network none --entrypoint python "$IMAGE" -c 'import os; print(os.getuid())' | tail -n1)
case "$AF_UID" in '' | *[!0-9]*) die "could not read the container user ID from $IMAGE" ;; esac
chown "$AF_UID:0" "$BASE/logs" "$BASE/config"
printf '%s' "$PASSWORDS" > "$BASE/config/passwords.json"
chown "$AF_UID:0" "$BASE/config/passwords.json"
chmod 0600 "$BASE/config/passwords.json"

# ------------------------------------------------------------------ 5. database check and systemd services

# Fail fast with a clear message when RDS is unreachable or the credentials are
# wrong. Bypasses the image entrypoint, which would otherwise wait forever.
log "checking the database connection"
if ! timeout 300 "$RT" run --rm --network host --env-file "$ETC/airflow.env" --entrypoint airflow "$IMAGE" db check --retry 12 --retry-delay 5; then
  die "cannot connect to the metadata database. Check the RDS endpoint, security groups and the SSM secret from this instance"
fi

# Each service calls airflow-run, which holds the container options and health checks.
umask 022
printf 'RUNTIME=%s\nIMAGE=%s\nSELINUX_LABEL=%s\n' "$RT" "$IMAGE" "$SELINUX_LABEL" > "$ETC/run.conf"
cat > /usr/local/bin/airflow-run << 'AIRFLOW_RUN'
${airflow_run}AIRFLOW_RUN
chmod 0755 /usr/local/bin/airflow-run

DEP=''
if [ "$RUNTIME" = docker ]; then DEP='docker.service'; fi

# write_unit COMPONENT [oneshot]
write_unit() {
  local name=airflow-$1 after=$DEP
  if [ "$1" != db-migrate ]; then after="$after airflow-db-migrate.service"; fi
  {
    echo "# Written by the Airflow bootstrap (EC2 user data). Re-running it overwrites this file."
    echo "[Unit]"
    echo "Description=Airflow $1"
    echo "Wants=network-online.target"
    echo "After=network-online.target $after"
    echo "Requires=$after"
    echo ""
    echo "[Service]"
    if [ "$${2:-}" = oneshot ]; then
      echo "Type=oneshot"
      echo "RemainAfterExit=yes"
      echo "TimeoutStartSec=1800"
    else
      echo "Restart=always"
      echo "RestartSec=10"
      echo "ExecStop=-$RT stop -t 60 $name"
    fi
    echo "ExecStartPre=-$RT rm -f $name"
    echo "ExecStart=/usr/local/bin/airflow-run $1"
    echo ""
    echo "[Install]"
    echo "WantedBy=multi-user.target"
  } > "/etc/systemd/system/$name.service"
}

write_unit db-migrate oneshot
for c in $COMPONENTS; do write_unit "$c"; done
systemctl daemon-reload

log "migrating the database"
systemctl enable airflow-db-migrate
systemctl restart airflow-db-migrate || die "db migrate failed: journalctl -u airflow-db-migrate"

for c in $COMPONENTS; do
  log "starting airflow-$c"
  systemctl enable "airflow-$c"
  systemctl restart "airflow-$c"
done

# ------------------------------------------------------------------ 6. verify

log "waiting for the API server"
API_OK=0
for _ in $(seq 1 60); do
  if curl -fsS http://127.0.0.1:8080/api/v2/monitor/health > /dev/null 2>&1; then API_OK=1; break; fi
  sleep 5
done
[ "$API_OK" = 1 ] || die "API server not healthy after 5 minutes: journalctl -u airflow-api-server"

# Catch components that start, then crash on config, DAG or database errors.
sleep 20
FAILED=''
for c in $COMPONENTS; do
  if ! systemctl is-active --quiet "airflow-$c"; then
    journalctl -u "airflow-$c" -n 40 --no-pager || true
    FAILED="$FAILED airflow-$c"
  fi
done
[ -z "$FAILED" ] || die "not running:$FAILED"
systemctl --no-pager --lines=0 status airflow-api-server airflow-scheduler airflow-dag-processor airflow-triggerer || true
log "Airflow is up"
